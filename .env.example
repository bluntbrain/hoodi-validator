# Copy to .env and edit. Only TELEGRAM_BOT_TOKEN and GRAFANA_ADMIN_PASSWORD are secret.

# --- client versions ---
# Hoodi forks before mainnet, so it needs the newest clients. Glamsterdam activated on Hoodi
# on 2026-10-26; anything older than these will not follow the chain. Check the release pages
# before bumping: https://github.com/paradigmxyz/reth/releases https://github.com/sigp/lighthouse/releases
RETH_IMAGE=ghcr.io/paradigmxyz/reth:v2.8.0
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.3.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1

# --- network ---
NETWORK=hoodi
# Checkpoint sync endpoint. Verify the finalized root it hands you (docs/runbook.md, "First sync").
# Fallback: https://hoodi.beaconstate.ethstaker.cc
CHECKPOINT_SYNC_URL=https://checkpoint-sync.hoodi.ethpandaops.io

# --- validator ---
# Address that receives priority fees from blocks you propose. Any Hoodi address you control.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
GRAFFITI=bluntbrain/hoodi-validator

# --- p2p ports published on the host (open them in the firewall, see deploy/host-setup.sh) ---
RETH_P2P_PORT=30303
LIGHTHOUSE_P2P_PORT=9000
LIGHTHOUSE_QUIC_PORT=9001

# --- monitoring ---
# Grafana binds to 127.0.0.1 only. Reach it with: ssh -L 3000:127.0.0.1:3000 user@host
GRAFANA_ADMIN_PASSWORD=change-me
# Alertmanager -> Telegram. Create a bot with @BotFather; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
