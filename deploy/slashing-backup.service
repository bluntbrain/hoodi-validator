# Daily slashing-protection export. Pair with slashing-backup.timer.
# Install both:
#   sudo cp deploy/slashing-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now slashing-backup.timer

[Unit]
Description=Export Lighthouse slashing-protection database
After=hoodi-validator.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hoodi-validator
ExecStart=/home/ubuntu/hoodi-validator/scripts/backup-slashing-protection.sh
# Optional: copy off-host. Set BACKUP_RSYNC_TARGET in /etc/default/slashing-backup, e.g. user@nas:/srv/backups/hoodi/
EnvironmentFile=-/etc/default/slashing-backup
ExecStartPost=/bin/sh -c '[ -z "$BACKUP_RSYNC_TARGET" ] || rsync -a --delete backups/ "$BACKUP_RSYNC_TARGET"'
